# =====================================================================
# Agente de Recepción del Encargo — Wink Group
# Copia este archivo a .env.local (desarrollo) y configura las mismas
# variables en Vercel (Project Settings → Environment Variables).
# NUNCA subas .env.local al repositorio.
# =====================================================================

# --- Supabase (proyecto "wink-recepcion-encargo", región eu-west-3 / París) ---
NEXT_PUBLIC_SUPABASE_URL=https://xfpqxffigjpdafxdatup.supabase.co
# Clave pública (publishable/anon). Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role / sb_secret_...). SOLO servidor. Dashboard → API Keys
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Modelo económico: triage, clasificación y extracción de documentos
MODEL_FAST=claude-haiku-5-5
# Modelo potente: briefing, alcance y redacción de correos
# (claude-opus-5-5 = máxima calidad; claude-sonnet-5-5 = más rápido, recomendado para la demo)
MODEL_SMART=claude-sonnet-5-5

# --- Correo ---
# imap    → buzón real por IMAP/SMTP (Hostinger para la demo)
# fixture → no se conecta a ningún servidor: los correos se inyectan con `npm run demo:load`
#           y los envíos solo se registran en la base de datos (ensayos sin red)
EMAIL_PROVIDER=imap
AGENT_MAILBOX=prueba@aibetech.es
AGENT_DISPLAY_NAME=Wink Group · Encargos
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
MAIL_USER=prueba@aibetech.es
# Contraseña del buzón (hPanel → Emails → prueba@aibetech.es)
MAIL_PASSWORD=
# Carpeta donde se guarda copia de lo enviado (en Hostinger suele ser "INBOX.Sent" o "Sent")
IMAP_SENT_FOLDER=auto
# Seguridad: si se rellena, los correos SALIENTES a direcciones que no estén en esta lista
# se desvían a DEMO_REDIRECT_TO (útil en la demo para no escribir a direcciones ficticias)
DEMO_ALLOWED_RECIPIENTS=
DEMO_REDIRECT_TO=

# --- Agenda ---
# mock | google | microsoft
CALENDAR_PROVIDER=mock
# Google Calendar (OAuth con refresh token de la cuenta que gestiona las visitas)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Microsoft 365 (app registration con permiso de aplicación Calendars.ReadWrite)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALENDAR_USER=

# --- Sincronización opcional de carpetas: none | gdrive | sharepoint ---
FOLDER_SYNC_PROVIDER=none

# --- Seguridad de endpoints internos ---
# Secreto compartido para /api/cron/* y /api/worker (Vercel Cron envía "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# URL pública de la app (para enlaces en avisos internos)
APP_BASE_URL=http://localhost:3000

# --- Integración con la app de WhatsApp de Wink (C:\Whatsapp-Wink) ---
# URL pública de la app de WhatsApp (en local: http://localhost:3001)
WHATSAPP_APP_URL=
# Secreto compartido: EL MISMO valor en las dos apps (openssl rand -hex 32). Vacío = integración desactivada
INTEGRATION_SECRET=

# --- Entorno de demo ---
# Permite /api/demo/* y el script demo:reset. Pon "false" en producción.
DEMO_MODE=true
